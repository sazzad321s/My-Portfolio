# Optional: your deployed URL (used for SEO / Open Graph). Vercel sets a fallback automatically.
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Optional: free access key from https://web3forms.com to make the contact form send email directly.
# Leave empty to use the built-in "open my email app" fallback.
NEXT_PUBLIC_WEB3FORMS_KEY=
